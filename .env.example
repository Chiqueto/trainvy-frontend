# Origem física do backend para rewrite do Next.js (SERVER-ONLY, sem NEXT_PUBLIC_)
# Em desenvolvimento local: http://localhost:8080
# Em homologação Vercel: https://trainvy-api.vercel.app
BACKEND_ORIGIN=http://localhost:8080

# URL pública da API consumida pelo frontend (através do rewrite first-party /backend)
# Em desenvolvimento local: http://localhost:8080 (ou http://localhost:3000/backend)
# Em homologação Vercel: https://trainvy.vercel.app/backend
NEXT_PUBLIC_API_URL=http://localhost:8080

# Frontend Base URL (Next.js)
# Em desenvolvimento local: http://localhost:3000
# Em homologação Vercel: https://trainvy.vercel.app
NEXT_PUBLIC_BASE_URL=http://localhost:3000
